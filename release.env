# Which Firefox ESR line we build on. Changing ESR_MAJOR is the once-a-year big update:
# move to the new ESR and re-check every patch in patches/.
ESR_MAJOR=153

# The program's internal name: the binary, and the profile folder (~/.<name>).
APP_NAME=aether

# The name people see: window titles, About dialog, menus.
DISPLAY_NAME=Astrelle
